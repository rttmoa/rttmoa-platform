{
	"name": "rttmoa-platform",
	"private": true,
	"packageManager": "npm@11.19.0",
	"version": "3.1.17",
	"description": "rttmoa-platform open source management system",
	"author": {
		"name": "rttmoa",
		"email": "rttmoa@gmail.com",
		"url": "https://github.com/rttmoa"
	},
	"license": "MIT",
	"homepage": "https://github.com/rttmoa",
	"repository": {
		"type": "git",
		"url": "git@github.com:rttmoa/rttmoa-platform.git"
	},
	"bugs": {
		"url": "https://github.com/rttmoa/rttmoa-platform/issues"
	},
	"engines": {
		"node": ">=24.15.0 <25"
	},
	"scripts": {
		"server": "cd service && yarn start",
		"start:client": "cd . && yarn start",
		"dev": "concurrently -n server,client -c blue,green \"yarn server\" \"yarn start\"",
		"start": "vite",
		"serve": "serve -s dist -l 9889",
		"build": "vite build",
		"build:dev": "npm run type:check && vite build --mode development",
		"build:test": "npm run type:check && vite build --mode test",
		"build:production": "npm run type:check && vite build --mode production",
		"build:production:debug": "npm run type:check && vite build --mode production --debug",
		"build:dev:preview": "npm run build:dev && vite preview",
		"build:prod:preview": "npm run build:production && vite preview",
		"tailwindcss": "tailwindcss -i src/styles/index.css -o build.css --minify",
		"type:check": "node node_modules/typescript-compiler/bin/tsc --noEmit --skipLibCheck",
		"lint": "npm run lint:eslint  && npm run lint:prettier",
		"lint:fix": "npm run eslint:fix && npm run stylelint && npm run lint:prettier:fix",
		"lint:eslint": "eslint ./src",
		"lint:eslint:fix": "eslint --fix --cache ./src",
		"lint:prettier": "prettier --write --log-level warn \"src/**/*.{js,ts,json,tsx,css,less,scss,html,md}\"",
		"lint:prettier:check": "prettier --check \"src/**/*\" --end-of-line auto --ignore-unknown",
		"lint:prettier:fix": "prettier --write \"src/**/*\" --end-of-line auto --ignore-unknown",
		"lint:prettier:fix:all": "prettier --write . --end-of-line auto --ignore-unknown",
		"lint:prettier:single": "prettier --write \"src/views/system/userManage/index.tsx\" --end-of-line auto --ignore-unknown",
		"lint:stylelint": "stylelint --cache --fix \"**/*.{less,postcss,css,scss}\" --cache --cache-location node_modules/.cache/stylelint/",
		"lint:lint-staged": "lint-staged",
		"markdownlint": "markdownlint *.md",
		"markdownlint:fix": "markdownlint --fix *.md",
		"changelog": "conventional-changelog -p angular -i CHANGELOG.md -s",
		"prepare": "husky",
		"clean:lock": "rimraf package-lock.json yarn.lock pnpm-lock.yaml",
		"clean:dist": "rimraf ./dist",
		"clean:modules": "rimraf node_modules",
		"push:tags": "git push --follow-tags origin pre-gh-pages",
		"release": "standard-version",
		"release:patch": "standard-version --release-as patch",
		"release:minor": "standard-version --release-as minor",
		"release:major": "standard-version --release-as major",
		"rimraf": "rimraf node_modules",
		"tree": "npx tree-node-cli -L 3 -I node_modules > OUT.txt",
		"commit": "git add -A && czg && git push",
		"releasePatch": "standard-version --release-as patch",
		"push": "git push --follow-tags origin main",
		"commitTag": "npm run commit && npm run releasePatch && npm run push",
		"predeploy": "npm run build:production",
		"deploy": "gh-pages -d dist -b gh-pages",
		"RELEASES": "npm run commit && npm run releasePatch && npm run push && npm run deploy"
	},
	"dependencies": {
		"@ant-design/cssinjs": "^2.1.2",
		"@ant-design/icons": "^6.3.4",
		"@ant-design/pro-components": "3.1.14-7",
		"@dnd-kit/core": "^6.3.1",
		"@dnd-kit/sortable": "^10.0.0",
		"@dnd-kit/utilities": "^3.2.2",
		"@react-spring/core": "^10.1.2",
		"@react-spring/web": "^10.1.2",
		"@reduxjs/toolkit": "^2.12.0",
		"@wangeditor/editor": "^5.1.23",
		"@wangeditor/editor-for-react": "^1.0.6",
		"ag-grid-react": "^36.1.0",
		"ahooks": "^3.10.0",
		"antd": "^6.6.3",
		"antd-img-crop": "^4.30.0",
		"axios": "^1.20.0",
		"dayjs": "^1.11.23",
		"echarts": "^6.1.0",
		"echarts-liquidfill": "3.1.0",
		"file-saver": "^2.0.5",
		"i18next": "^26.4.2",
		"lodash": "^4.18.1",
		"masonic": "^4.1.0",
		"nprogress": "^0.2.0",
		"qs": "^6.16.0",
		"react": "^19.3.0",
		"react-colorful": "^5.8.1",
		"react-countup": "^6.5.3",
		"react-dom": "^19.3.0",
		"react-highlight-words": "^0.21.0",
		"react-i18next": "^17.0.13",
		"react-redux": "^9.3.0",
		"react-router-dom": "^7.18.3",
		"react-transition-group": "^4.4.5",
		"recharts": "^3.10.1",
		"redux-persist": "^6.0.0",
		"redux-thunk": "^3.1.0",
		"tailwindcss": "^4.3.3",
		"xlsx": "^0.18.5",
		"react-is": "^19.3.0"
	},
	"devDependencies": {
		"@commitlint/cli": "^21.2.2",
		"@commitlint/config-conventional": "^21.2.2",
		"@types/lodash": "^4.17.25",
		"@types/node": "^22.20.2",
		"@types/nprogress": "^0.2.3",
		"@types/qs": "^6.15.1",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@types/react-transition-group": "^4.4.12",
		"@typescript-eslint/eslint-plugin": "^8.70.0",
		"@typescript-eslint/parser": "^8.70.0",
		"@vitejs/plugin-react": "^6.1.1",
		"autoprefixer": "^10.5.5",
		"concurrently": "^10.0.5",
		"cssnano": "^9.0.4",
		"cz-git": "^1.14.0",
		"czg": "^1.14.0",
		"dotenv": "^17.4.2",
		"eslint": "^10.10.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-prettier": "^5.5.6",
		"eslint-plugin-react": "^7.37.5",
		"eslint-plugin-react-hooks": "^7.1.1",
		"gh-pages": "^6.3.0",
		"husky": "^9.1.7",
		"less": "^4.9.1",
		"lint-staged": "^17.5.0",
		"postcss": "^8.5.28",
		"postcss-html": "^2.0.0",
		"postcss-less": "^6.0.0",
		"prettier": "^3.9.6",
		"rollup-plugin-visualizer": "^7.1.1",
		"serve": "^14.2.6",
		"standard-version": "^9.5.0",
		"stylelint": "^17.15.0",
		"stylelint-config-standard": "^40.0.0",
		"typescript": "~6.0.3",
		"typescript-compiler": "npm:typescript@7.0.2",
		"vite": "^8.2.2",
		"vite-plugin-checker": "^0.14.5",
		"vite-plugin-compression": "^0.5.1",
		"vite-plugin-html": "^3.2.2",
		"vite-plugin-pwa": "^1.3.0",
		"vite-plugin-require-transform": "^1.0.21",
		"vite-plugin-svg-icons": "^2.0.1",
		"@tailwindcss/postcss": "^4.3.3",
		"@tailwindcss/cli": "^4.3.3",
		"@eslint/compat": "^2.1.1",
		"@eslint/js": "^10.0.1",
		"globals": "^17.12.0",
		"conventional-commits-filter": "^6.0.1"
	},
	"browserslist": {
		"production": [
			"> 1%",
			"not dead",
			"not op_mini all"
		],
		"development": [
			"last 1 chrome version",
			"last 1 firefox version",
			"last 1 safari version"
		]
	},
	"config": {
		"commitizen": {
			"path": "node_modules/cz-git"
		}
	},
	"overrides": {
		"echarts-liquidfill": {
			"echarts": "$echarts"
		},
		"eslint-plugin-react": {
			"eslint": "$eslint"
		},
		"@typescript-eslint/eslint-plugin": {
			"typescript": "6.0.3"
		},
		"@typescript-eslint/parser": {
			"typescript": "6.0.3"
		},
		"@typescript-eslint/typescript-estree": {
			"typescript": "6.0.3"
		},
		"@typescript-eslint/utils": {
			"typescript": "6.0.3"
		},
		"@typescript-eslint/type-utils": {
			"typescript": "6.0.3"
		},
		"vite-plugin-checker": {
			"typescript": "6.0.3"
		}
	}
}
